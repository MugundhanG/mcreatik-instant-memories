# ---- Database (Supabase: use the SESSION pooler or direct connection, not the transaction pooler) ----
DATABASE_URL=jdbc:postgresql://db.xxxxx.supabase.co:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=

# ---- Public URLs ----
PUBLIC_GALLERY_BASE_URL=https://instant-memories.mcreatik.com
API_PUBLIC_BASE_URL=https://im-api.mcreatik.com
CORS_ALLOWED_ORIGINS=https://instant-memories.mcreatik.com

# ---- Security ----
# 32+ random bytes, e.g. `openssl rand -base64 48`
JWT_SECRET=
# First admin account, created only when no admin exists yet
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Storage: Cloudflare R2 ----
STORAGE_TYPE=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ORIGINALS_BUCKET=mcreatik-instant-memories-originals
R2_MEDIA_BUCKET=mcreatik-instant-memories-media
# Custom domain connected to the media bucket (public), e.g. https://im-media.mcreatik.com
R2_MEDIA_PUBLIC_BASE_URL=

# ---- Tuning (optional) ----
PROCESSING_WORKERS=2
UPLOAD_MAX_FILE_SIZE_BYTES=62914560
RETENTION_DEFAULT_DAYS=90
