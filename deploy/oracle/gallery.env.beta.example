# McreatiK Instant Memories BETA backend: settings for the beta Oracle VM.
# Copy to ~/mcreatik-gallery/gallery.env on the BETA server, fill in, then: chmod 600 ~/mcreatik-gallery/gallery.env
# Never commit the filled-in file. No quotes around values (docker --env-file takes them literally, except that a
# trailing space in MAIL_SUBJECT_PREFIX is optional: the backend adds one if missing).
# Beta has its OWN database, buckets, JWT secret and admin login: nothing is shared with production.

# ---- Database: separate Supabase project "mcreatik-instant-memories-beta" (Mumbai) ----
# Supabase dashboard -> Connect -> "Session pooler" (NOT "Transaction pooler"; the direct db.* host is IPv6-only).
# Flyway creates the tables on the first start.
DATABASE_URL=jdbc:postgresql://SESSION_POOLER_HOST:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres.PROJECT_REF
DATABASE_PASSWORD=

# ---- Public URLs ----
PUBLIC_GALLERY_BASE_URL=https://beta.live.mcreatik.com
API_PUBLIC_BASE_URL=https://api.beta.mcreatik.com
CORS_ALLOWED_ORIGINS=https://beta.live.mcreatik.com

# ---- Security ----
# Generate on the server: openssl rand -base64 48 (a NEW secret, never production's)
JWT_SECRET=
# First dashboard login; only used when no admin exists yet.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Storage: Cloudflare R2 (token scoped to the two BETA buckets only) ----
STORAGE_TYPE=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ORIGINALS_BUCKET=mcreatik-instant-memories-beta-originals
R2_MEDIA_BUCKET=mcreatik-instant-memories-beta-media
# The r2.dev public URL of the beta media bucket (same value as VITE_MEDIA_BASE_URL on the beta Worker).
R2_MEDIA_PUBLIC_BASE_URL=

# ---- Tuning (small VM: 1 GB E2.1.Micro, ~500 MB usable + swap, same as production's example) ----
PROCESSING_WORKERS=1
RETENTION_DEFAULT_DAYS=90
DATABASE_POOL_SIZE=3
JAVA_TOOL_OPTIONS=-Xmx320m -XX:MaxMetaspaceSize=160m -Xss512k -XX:+UseSerialGC -XX:TieredStopAtLevel=1 -XX:+ExitOnOutOfMemoryError

# ---- Email ----
# Same Gmail SMTP as production, or leave MAIL_HOST empty to send nothing. Every subject starts with the prefix,
# so a beta mail is never mistaken for a real one.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=connect@mcreatik.com
MAIL_PASSWORD=APP_PASSWORD_FROM_GOOGLE
MAIL_FROM=McreatiK <connect@mcreatik.com>
MAIL_SUBJECT_PREFIX=[BETA] 
