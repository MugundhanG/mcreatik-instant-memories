# McreatiK Instant Memories backend: settings for the Oracle VM.
# Copy to ~/mcreatik-gallery/gallery.env on the server, fill in, then: chmod 600 ~/mcreatik-gallery/gallery.env
# Never commit the filled-in file. No quotes around values (docker --env-file takes them literally).

# ---- Database: Supabase project "mcreatik-instant-memories" (Mumbai) ----
# Supabase dashboard -> Connect -> "Session pooler" (NOT "Transaction pooler"; the direct db.* host is IPv6-only).
# Host looks like aws-0-ap-south-1.pooler.supabase.com, user looks like postgres.<project-ref>.
DATABASE_URL=jdbc:postgresql://SESSION_POOLER_HOST:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres.PROJECT_REF
DATABASE_PASSWORD=
# Live + test container during a deploy stay well under the free pooler's client limit.
DATABASE_POOL_SIZE=5

# ---- Public URLs ----
PUBLIC_GALLERY_BASE_URL=https://instant-memories.mcreatik.com
API_PUBLIC_BASE_URL=https://im-api.mcreatik.com
CORS_ALLOWED_ORIGINS=https://instant-memories.mcreatik.com

# ---- Security ----
# Generate on the server: openssl rand -base64 48
JWT_SECRET=
# First dashboard login; only used when no admin exists yet. Use a new password (not the website admin's).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Storage: Cloudflare R2 (token scoped to the two instant-memories buckets only) ----
STORAGE_TYPE=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ORIGINALS_BUCKET=mcreatik-instant-memories-originals
R2_MEDIA_BUCKET=mcreatik-instant-memories-media
# r2.dev URL for testing; https://im-media.mcreatik.com once mcreatik.com DNS is on Cloudflare.
R2_MEDIA_PUBLIC_BASE_URL=

# ---- Tuning ----
PROCESSING_WORKERS=2
RETENTION_DEFAULT_DAYS=90

# ---- Small VM (1 GB E2.1.Micro, ~500 MB usable + swap): uncomment these three ----
# PROCESSING_WORKERS=1
# DATABASE_POOL_SIZE=3
# JAVA_TOOL_OPTIONS=-Xmx320m -XX:MaxMetaspaceSize=160m -Xss512k -XX:+UseSerialGC -XX:TieredStopAtLevel=1 -XX:+ExitOnOutOfMemoryError
